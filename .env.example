# ─────────────────────────────────────────────────────────────
# .env.example — 새 환경변수가 생기면 키 이름만 여기에 추가.
# 실제 값은 `.env` (gitignore) 또는 Vercel 대시보드 / Doppler 에 보관.
# 사용: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# 사이트 root URL (canonical / sitemap / og:url 등에 사용)
NEXT_PUBLIC_SITE_URL=https://example.com

# 앱 환경 (development | preview | production) — Vercel 자동 주입
NODE_ENV=development

# Prisma Postgres 연결 문자열 (서버 전용 — NEXT_PUBLIC_ 붙이지 말 것)
DATABASE_URL=postgresql://user:password@localhost:5432/evidence_finder?schema=public

# Brave Search API 토큰 (서버 전용 — NEXT_PUBLIC_ 붙이지 말 것)
BRAVE_API_KEY=

# 운영자 공유 비밀 (서버 전용 — NEXT_PUBLIC_ 붙이지 말 것). 모든 페이지와 /api/* 가
# HTTP Basic 인증의 비밀번호로 이 값을 요구한다(사용자명은 무시). 비어 있으면 503.
EVIDENCE_FINDER_OPERATOR_SECRET=change-me
