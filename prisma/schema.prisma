datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Case {
  id              String   @id @default(cuid())
  identifyingTerms String?
  title           String?
  createdAt       DateTime @default(now())
  evidence        Evidence[]
}

model Evidence {
  id         String   @id @default(cuid())
  url        String
  detectedAt DateTime
  pageTitle  String
  domain     String
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
}

model Candidate {
  id        String   @id @default(cuid())
  url       String
  caseId    String
  status    String   @default("new")
  title     String?
  createdAt DateTime @default(now())

  @@unique([url, caseId])
  @@index([caseId])
}
